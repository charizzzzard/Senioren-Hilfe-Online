# Nur Weg B. Voraussetzung: Dispatcher ist implementiert und installiert.
[Unit]
Description=Netzleicht Job-Termine abgleichen
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/netzleicht/control/tools/ops/dispatcher.py

[Service]
Type=oneshot
User=netzleicht-control
Group=netzleicht-control
WorkingDirectory=/opt/netzleicht/control
ExecStart=/usr/bin/python3 /opt/netzleicht/control/tools/ops/dispatcher.py tick --config /etc/netzleicht/jobs.yaml
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/netzleicht/state
