{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Netzleicht operations job result - proposed contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "run_id", "status", "summary", "evidence", "external_operations", "blockers"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "blocked", "skipped"]},
    "summary": {"type": "string"},
    "source_sha": {"type": ["string", "null"]},
    "target_sha": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "external_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_key", "kind", "outcome"],
        "properties": {
          "operation_key": {"type": "string", "minLength": 1},
          "kind": {"enum": ["pr", "review", "merge", "deploy", "notification", "device_session", "report"]},
          "outcome": {"enum": ["proposed", "confirmed", "rejected", "unknown"]},
          "reference": {"type": ["string", "null"]}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
